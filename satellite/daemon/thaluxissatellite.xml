<service>
	<id>thaluxissatellite.exe</id>
	<name>ThaluxisSatellite</name>
	<description>Thaluxis Satellite — VirtualDJ OS2L link and track analysis for Thaluxis DMX hub.</description>
	<executable>C:\Program Files\nodejs\node.exe</executable>
	<argument>--harmony</argument>
	<argument>C:\source\Node\dmx-controller\satellite\node_modules\node-windows\lib\wrapper.js</argument>
	<argument>--file</argument>
	<argument>C:\source\Node\dmx-controller\satellite\server.js</argument>
	<argument>--scriptoptions=</argument>
	<argument>--log</argument>
	<argument>ThaluxisSatellite wrapper</argument>
	<argument>--grow</argument>
	<argument>0.5</argument>
	<argument>--wait</argument>
	<argument>2</argument>
	<argument>--maxrestarts</argument>
	<argument>10</argument>
	<argument>--abortonerror</argument>
	<argument>n</argument>
	<argument>--stopparentfirst</argument>
	<argument>undefined</argument>
	<logmode>rotate</logmode>
	<stoptimeout>30sec</stoptimeout>
	<env name="NODE_ENV" value="production"/>
	<serviceaccount>
		<domain>JARVIS</domain>
		<user>LocalSystem</user>
		<password></password>
	</serviceaccount>
	<workingdirectory>C:\source\Node\dmx-controller\satellite</workingdirectory>
</service>