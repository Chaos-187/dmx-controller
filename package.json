{
  "name": "dmx-controller",
  "version": "1.3.2",
  "description": "Thaluxis DMX — Lighting control forged for live events. VirtualDJ OS2L integration.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chaos-187/dmx-controller.git"
  },
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node scripts/dev-watch.js",
    "satellite": "node satellite/server.js",
    "satellite:dev": "node --watch satellite/server.js",
    "master:service:install": "npm run rebuild:native && node scripts/windows-service.js install",
    "master:service:uninstall": "node scripts/windows-service.js uninstall",
    "service:install": "npm run master:service:install",
    "service:uninstall": "npm run master:service:uninstall",
    "satellite:service:install": "npm run rebuild:native && npm install --prefix satellite && npm run service:install --prefix satellite",
    "satellite:service:uninstall": "npm run service:uninstall --prefix satellite",
    "build": "node build.js",
    "release:prepare": "node scripts/release-prepare.js",
    "rebuild:native": "npm rebuild better-sqlite3 ftdi-d2xx usb",
    "rebuild:native:dev": "node scripts/rebuild-native-dev.js",
    "companion:config": "node companion/generate-config.cjs"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "node_modules/waveform-data/dist/**/*",
      "node_modules/better-sqlite3/build/Release/better_sqlite3.node",
      "node_modules/better-sqlite3/build/Release/test_extension.node",
      "node_modules/ftdi-d2xx/build/Release/*.node",
      "node_modules/usb/prebuilds/win32-x64/*.node"
    ],
    "scripts": [
      "db.js",
      "artnet-server.js",
      "artnet-worker.js",
      "dmx-usb-server.js",
      "dmx-usb-worker.js",
      "audio-analyzer.js",
      "stem-separator.js",
      "sequence-generator.js",
      "midi-controller.js",
      "vdj-parser.js"
    ],
    "targets": [
      "node24-win-x64"
    ],
    "outputPath": "dist"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "bonjour-service": "^1.2.1",
    "compression": "^1.8.1",
    "express": "^4.18.2",
    "fast-xml-parser": "^5.3.6",
    "ftdi-d2xx": "^1.3.1",
    "jzz": "^1.9.6",
    "multicast-dns": "^7.2.5",
    "usb": "^2.17.0",
    "waveform-data": "^4.5.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.14.0",
    "node-windows": "^1.0.0-beta.8"
  }
}
